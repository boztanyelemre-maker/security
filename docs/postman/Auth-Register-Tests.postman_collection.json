{
  "info": {
    "name": "Auth Register Tests",
    "description": "POST /auth/register/buyer ve /provider testleri: 201, 409 email, 409 tax_id, 400 eksik alan",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "email", "value": "test-buyer-{{$randomInt}}.@test.com" },
    { "key": "tax_id", "value": "{{$randomInt}}{{$randomInt}}{{$randomInt}}{{$randomInt}}{{$randomInt}}" }
  ],
  "item": [
    {
      "name": "Buyer",
      "item": [
        {
          "name": "1) Basarili kayit → 201",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alici-test@postman.com\",\n  \"password\": \"guvenli123\",\n  \"full_name\": \"Postman Buyer\",\n  \"legal_name\": \"Test AVM A.S.\",\n  \"tax_id\": \"1111111111\",\n  \"hq_city_id\": 34\n}"
            },
