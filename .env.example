# Proje kökünde kopyala: cp .env.example .env
# Backend kendi .env'ini backend/.env olarak kullanır (veya kök .env'i paylaşır).

# Server (backend)
NODE_ENV=development
PORT=3000

# Database — lokal Docker: postgres://postgres:postgres@localhost:5432/gus_mvp
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gus_mvp

# Auth
JWT_SECRET=change_me_super_secret

# CORS (virgülle; Netlify + custom domain prod'da)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
