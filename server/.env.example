# Server
NODE_ENV=development
PORT=3000

# Database (Render: use Internal Database URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gus_mvp

# Auth
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# CORS (comma-separated; Netlify + custom domain)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.netlify.app
