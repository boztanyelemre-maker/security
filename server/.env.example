# Server
NODE_ENV=development
PORT=3000

# Database (Render: use Internal Database URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gus_mvp

# Auth (production'da JWT_SECRET zorunlu)
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# CORS (virgülle ayrılmış tam origin; wildcard desteklenmez)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
